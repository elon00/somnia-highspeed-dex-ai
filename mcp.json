{
  "mcpServers": {
    "somnia-highspeed-dex-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Somnia Network",
        "PROJECT_TICKER": "SOMSOUND"
      },
      "tools": [
        {
          "name": "verify_somsound_invariants",
          "description": "Verifies deterministic invariants for Somnia High-Speed DEX AI on Somnia Network."
        },
        {
          "name": "execute_somsound_action",
          "description": "Executes authenticated DeFi state transition."
        }
      ]
    }
  }
}